# Gemini / application generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_DELAY_SECONDS=8
GEMINI_GENERATION_DELAY_SECONDS=30
GEMINI_MAX_RETRIES=3
# Optional: point this at a local checkout of https://github.com/1carusalwayswa/apply
APPLY_SKILL_PATH=
COMPILE_LATEX=false

# Playwright and local data
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STATE_PATH=worker_env/stored_data/linkedin_state.json
RESUME_PATH=worker_env/stored_data/resume.md
RESUME_PDF_PATH=worker_env/stored_data/resume.pdf
TZ=Pacific/Auckland

# Optional SMTP daily report
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=
